---
import type { Lang } from '../i18n/content';
import { content } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const typewriterWords = t.hero.typewriterWords.join(',');
---

<!-- Hero -->
<section id="hero" class="bg-bg min-h-screen relative flex flex-col justify-center py-[120px] sm:py-[80px]">
  <div class="px-6 md:px-16 relative z-10">
    <div class="max-w-3xl">
      <p class="text-accent text-[10px] tracking-[0.20em] uppercase font-medium mb-6">{t.hero.kicker}</p>
      <h1 class="font-display font-light leading-none tracking-tight text-text-1 mb-2" style="font-size: clamp(52px, 8vw, 80px);">
        {t.hero.headlineLine1}
      </h1>
      <h1 class="font-display font-light leading-none tracking-tight text-text-1 mb-9" style="font-size: clamp(52px, 8vw, 80px);">
        <span id="typewriter" data-words={typewriterWords}></span>
      </h1>
      <p class="text-text-2 text-base leading-relaxed max-w-[540px] mb-9">{t.hero.subline}</p>
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-7">
        <a
          href="#ziele"
          class="bg-accent text-white text-[11px] tracking-[0.12em] uppercase font-medium px-6 py-3 rounded-sm hover:bg-accent-light transition-colors"
        >
          {t.hero.cta}
        </a>
        <a
          href="#kontakt"
          class="text-text-2 text-[11px] tracking-[0.12em] uppercase border-b border-border-hover pb-0.5 hover:text-text-1 hover:border-text-2 transition-colors"
        >
          {t.hero.ctaSecondary}
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Ziele -->
<section id="ziele" class="py-24 bg-bg-2 relative overflow-visible">
  <!-- Dot-grid texture: anchored to top-right, bleeds upward into hero -->
  <div
    class="hidden sm:block absolute top-0 right-0 pointer-events-none z-10"
    style="background-image: radial-gradient(circle, #818cf8 1.5px, transparent 1.5px); background-size: 16px 16px; width: 320px; height: 192px; opacity: 0.4; transform: translateY(-112px);"
  ></div>
  <div class="max-w-5xl mx-auto px-6">
    <h2 class="font-display font-light text-text-1 text-3xl tracking-tight mb-14 text-center">{t.ziele.title}</h2>
    <div class="grid sm:grid-cols-3 gap-6">
      {t.ziele.items.map((item) => (
        <div class="bg-bg-3 border border-border rounded-md p-6 hover:border-border-hover transition-colors">
          <div class="w-9 h-9 bg-accent-dim border border-accent rounded text-accent flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h3 class="font-display font-medium text-text-1 text-lg mt-4 mb-2">{item.title}</h3>
          <p class="text-text-2 text-sm leading-relaxed">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>


<!-- Projekte -->
<section id="projekte" class="py-24 bg-bg">
  <div class="max-w-5xl mx-auto px-6">
    <h2 class="font-display font-light text-text-1 text-3xl tracking-tight mb-14 text-center">{t.projekte.title}</h2>
    <div class="grid sm:grid-cols-3 gap-6">
      {t.projekte.items.map((item) => (
        <div class="bg-bg-3 border border-border rounded-md p-6 hover:border-border-hover transition-colors">
          <span class="text-accent text-[9px] tracking-[0.14em] uppercase bg-accent-dim px-2 py-1 rounded-sm inline-block mb-3">{item.tag}</span>
          <h3 class="font-display font-medium text-text-1 text-lg mb-2">{item.title}</h3>
          <p class="text-text-2 text-sm leading-relaxed">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Kontakt -->
<section id="kontakt" class="py-24 bg-bg-2">
  <div class="max-w-2xl mx-auto px-6">
    <h2 class="font-display font-light text-text-1 text-3xl tracking-tight mb-4 text-center">{t.kontakt.title}</h2>
    <p class="text-text-2 text-center mb-12">{t.kontakt.description}</p>
    <form class="space-y-5" name="contact" method="POST" data-netlify="true">
      <input type="hidden" name="form-name" value="contact" />
      <div>
        <label class="block text-text-3 text-[10px] tracking-[0.12em] uppercase mb-2" for="name">{t.kontakt.name}</label>
        <input
          id="name"
          type="text"
          name="name"
          required
          placeholder={t.kontakt.namePlaceholder}
          class="w-full bg-bg-3 border border-border focus:border-accent text-text-1 placeholder:text-text-3 rounded-sm px-4 py-2.5 text-sm outline-none transition-colors"
        />
      </div>
      <div>
        <label class="block text-text-3 text-[10px] tracking-[0.12em] uppercase mb-2" for="email">{t.kontakt.email}</label>
        <input
          id="email"
          type="email"
          name="email"
          required
          placeholder={t.kontakt.emailPlaceholder}
          class="w-full bg-bg-3 border border-border focus:border-accent text-text-1 placeholder:text-text-3 rounded-sm px-4 py-2.5 text-sm outline-none transition-colors"
        />
      </div>
      <div>
        <label class="block text-text-3 text-[10px] tracking-[0.12em] uppercase mb-2" for="message">{t.kontakt.message}</label>
        <textarea
          id="message"
          name="message"
          required
          rows="5"
          placeholder={t.kontakt.messagePlaceholder}
          class="w-full bg-bg-3 border border-border focus:border-accent text-text-1 placeholder:text-text-3 rounded-sm px-4 py-2.5 text-sm outline-none transition-colors resize-none"
        ></textarea>
      </div>
      <button
        type="submit"
        class="w-full bg-accent text-white text-[11px] tracking-[0.12em] uppercase font-medium py-3 rounded-sm hover:bg-accent-light transition-colors"
      >
        {t.kontakt.send}
      </button>
    </form>
  </div>
</section>

<script>
  const el = document.getElementById('typewriter') as HTMLElement | null;
  if (el) {
    const words = (el.dataset.words ?? '').split(',');
    let wi = 0, ci = 0, deleting = false;
    function tick() {
      const word = words[wi];
      if (!deleting) {
        el!.textContent = word.slice(0, ci + 1);
        ci++;
        if (ci === word.length) { deleting = true; setTimeout(tick, 1800); return; }
      } else {
        el!.textContent = word.slice(0, ci - 1);
        ci--;
        if (ci === 0) { deleting = false; wi = (wi + 1) % words.length; }
      }
      setTimeout(tick, deleting ? 60 : 100);
    }
    setTimeout(tick, 1000);
  }
</script>
