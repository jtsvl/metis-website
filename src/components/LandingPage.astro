---
import type { Lang } from '../i18n/content';
import { content } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
---

<!-- Hero -->
<section class="min-h-screen flex items-center pt-16 bg-gradient-to-br from-indigo-50 via-white to-white">
  <div class="max-w-5xl mx-auto px-6 py-24">
    <div class="max-w-3xl">
      <span class="inline-block text-xs font-semibold tracking-widest text-indigo-500 uppercase mb-6">
        {lang === 'de' ? 'Gemeinnützig · Überparteilich · Evidenzbasiert' : 'Non-profit · Non-partisan · Evidence-based'}
      </span>
      <h1 class="text-5xl sm:text-6xl font-bold text-gray-900 leading-tight mb-6">
        {t.hero.headline[0]}<br />{t.hero.headline[1]}
      </h1>
      <p class="text-xl text-gray-500 leading-relaxed mb-10 max-w-2xl">
        {t.hero.subline}
      </p>
      <a
        href="#ziele"
        class="inline-flex items-center gap-2 bg-indigo-600 text-white px-7 py-3.5 rounded-lg font-medium hover:bg-indigo-700 transition-colors"
      >
        {t.hero.cta}
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </a>
    </div>
  </div>
</section>

<!-- Ziele -->
<section id="ziele" class="py-24 bg-white">
  <div class="max-w-5xl mx-auto px-6">
    <h2 class="text-3xl font-bold text-gray-900 mb-14 text-center">{t.ziele.title}</h2>
    <div class="grid sm:grid-cols-3 gap-8">
      {t.ziele.items.map((item) => (
        <div class="bg-indigo-50 rounded-2xl p-8 hover:shadow-md transition-shadow">
          <div class="w-10 h-10 bg-indigo-600 rounded-xl mb-5 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-3">{item.title}</h3>
          <p class="text-gray-500 text-sm leading-relaxed">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Projekte -->
<section id="projekte" class="py-24 bg-gray-50">
  <div class="max-w-5xl mx-auto px-6">
    <h2 class="text-3xl font-bold text-gray-900 mb-14 text-center">{t.projekte.title}</h2>
    <div class="grid sm:grid-cols-3 gap-8">
      {t.projekte.items.map((item) => (
        <div class="bg-white rounded-2xl p-8 border border-gray-100 hover:border-indigo-200 hover:shadow-md transition-all">
          <span class="inline-block text-xs font-semibold tracking-wider text-indigo-500 uppercase mb-4 bg-indigo-50 px-3 py-1 rounded-full">
            {item.tag}
          </span>
          <h3 class="text-lg font-semibold text-gray-900 mb-3">{item.title}</h3>
          <p class="text-gray-500 text-sm leading-relaxed">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Kontakt -->
<section id="kontakt" class="py-24 bg-white">
  <div class="max-w-5xl mx-auto px-6">
    <div class="max-w-2xl mx-auto">
      <h2 class="text-3xl font-bold text-gray-900 mb-4 text-center">{t.kontakt.title}</h2>
      <p class="text-gray-500 text-center mb-12">{t.kontakt.description}</p>
      <form class="space-y-5" name="contact" method="POST" data-netlify="true">
        <input type="hidden" name="form-name" value="contact" />
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5" for="name">{t.kontakt.name}</label>
          <input
            id="name"
            type="text"
            name="name"
            required
            placeholder={t.kontakt.namePlaceholder}
            class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent transition"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5" for="email">{t.kontakt.email}</label>
          <input
            id="email"
            type="email"
            name="email"
            required
            placeholder={t.kontakt.emailPlaceholder}
            class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent transition"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5" for="message">{t.kontakt.message}</label>
          <textarea
            id="message"
            name="message"
            required
            rows="5"
            placeholder={t.kontakt.messagePlaceholder}
            class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent transition resize-none"
          ></textarea>
        </div>
        <button
          type="submit"
          class="w-full bg-indigo-600 text-white py-3.5 rounded-lg font-medium hover:bg-indigo-700 transition-colors"
        >
          {t.kontakt.send}
        </button>
      </form>
    </div>
  </div>
</section>
